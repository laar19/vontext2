<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <!-- Exclude encrypted API keys and credentials from Google Cloud backup -->
        <exclude domain="sharedpref" path="vontext_secure_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <!-- Exclude encrypted API keys from unencrypted transfer -->
        <exclude domain="sharedpref" path="vontext_secure_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
